{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 15,
    "margin-right": 50,
    "margin-bottom": 0,
    "margin-left": 50,

    "modules-left": [
        "tray",
        "custom/launcher",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu_text",
        "cpu",
        "memory",
        "battery",
        "network"
    ],

    "custom/launcher":{
        "format": " ",
        "on-click": "rofi -show drun",
        "on-click-right": "killall rofi",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "format": "​♦  ♥   {:%H:%M - %a, %d %b %Y}  ♣  ♠",
        "tooltip": false
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2,

        "states": {
            "critical": 90
        }
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 2,

        "states": {
            "critical": 80
        }
    },

     "battery": {
            "interval":30,
            "states": {
                "good": 95,
                "warning": 35,
                "critical": 20
            },
            "format": "{icon} {capacity}%",
            "format-charging": "󰂄 {capacity}%",
            "format-plugged": "{capacity}% 󰂄 ",
            "format-alt": "{time}",
            "format-icons": [
                "󰁻",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂",
            "󰁹"
            ]
        },

    "network": {
        "format-wifi" : "  {bandwidthDownBits} ",
        "format-ethernet": "enth {bandwidthDownBits}",
        "format-disconnected" : "no network",
        "interval": 5,
        "tooltip": false
    },

    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "  {volume}% ",
        "format-bluetooth": "vol {volume}%",
        "nospacing": 1,
        "on-click": "pwvucontrol",
        "tooltip": false
    },

	"hyprland/language": {
		"format": "{short}"
	},

	"custom/control":{
        "format": " ",
        "on-click": "control",
        "on-click-right": "killall control",
        "tooltip": false
    }
}
